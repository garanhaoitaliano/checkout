PORT=3000
# URL pública (usada no webhook enviado ao gateway). Ex.: https://pay.seudominio.com
PUBLIC_URL=
# Gere um valor aleatório longo. Assina o cookie de login do admin.
SESSION_SECRET=troque-por-um-valor-aleatorio-longo
# Admin criado na primeira execução (troque a senha depois em Configurações)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
# Em produção (HTTPS): NODE_ENV=production  (ativa cookie Secure)
NODE_ENV=development
